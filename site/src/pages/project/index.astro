---
import Layout from '../../layouts/Layout.astro';
import Section from '@bundu/ui/Section.astro';
import SectionHeader from '@bundu/ui/SectionHeader.astro';
import { Button } from '@bundu/ui/ui/button';
import StatusPill from '../../components/StatusPill.astro';

const status: { state: 'live' | 'building' | 'planned'; title: string; body: string }[] = [
  {
    state: 'live',
    title: 'The architecture, in writing',
    body: 'docs.shamwari.ai documents exactly how routing, sovereignty and citation work, and it’s checked against the real code.',
  },
  {
    state: 'live',
    title: 'Data sovereignty enforcement',
    body: 'The two rules on the Blueprint page are live in code, enforced at more than one layer, and covered by tests — not policy on a page.',
  },
  {
    state: 'live',
    title: "Ground's storage and search",
    body: 'The database and search indexes behind retrieval are running and ready.',
  },
  {
    state: 'building',
    title: 'The Zimbabwean legal and tax corpus',
    body: 'Sources are being reviewed and approved one at a time — we ingest what we have the rights to, nothing scraped first and asked about later. The Constitution of Zimbabwe is first in.',
  },
  {
    state: 'building',
    title: 'Shamwari Cloud',
    body: 'The gateway and API are written and tested, and not yet serving production traffic.',
  },
  {
    state: 'planned',
    title: 'Shamwari Mind',
    body: 'The on-device, open-weight model — the part that makes the sovereignty promise real for everyday use, not just for the API.',
  },
  {
    state: 'planned',
    title: 'Voice and image',
    body: 'Including Shona and Ndebele speech, once a provider actually supports them well.',
  },
];

const tiers = [
  { name: 'Community', entity: 'Bundu Foundation', body: 'Shamwari Mind, downloadable, open weights, forever free. This is the community pillar — not a trial of something else.' },
  { name: 'Developer', entity: 'Nyuchi Africa', body: 'Pay-as-you-go API access to Shamwari Cloud, routed to the models that fit each request.' },
  { name: 'Business', entity: 'Nyuchi Africa', body: 'Committed monthly volume, an SLA, and usage dashboards for teams building on top of Shamwari.' },
  { name: 'Sovereign', entity: 'Nyuchi Africa', body: 'Mind and Ground deployed on your own infrastructure. No data leaves it, ever.' },
];
---
<Layout
  title="Project — where Shamwari actually stands · Shamwari AI"
  description="What's live, what's still being built, and who the four commercial tiers are for."
>
  <Section space="tight">
    <SectionHeader
      as="h1"
      size="display"
      eyebrow="Project"
      title="Where things actually stand"
      description="We'd rather this page be a little less impressive and stay true than round anything up."
      max="max-w-2xl"
    />
  </Section>

  <Section bg="secondary" border>
    <ul class="flex max-w-2xl flex-col gap-6">
      {status.map((item) => (
        <li class="flex flex-col gap-1.5">
          <div class="flex flex-wrap items-baseline gap-3">
            <StatusPill state={item.state} />
            <span class="font-semibold text-foreground">{item.title}</span>
          </div>
          <p class="text-body-sm text-muted-foreground">{item.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <SectionHeader eyebrow="Who it's for" title="Four ways to use it" max="max-w-2xl" />
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {tiers.map((tier) => (
        <div class="card p-6">
          <h3 class="font-semibold text-foreground">{tier.name}</h3>
          <p class="mt-1 text-caption font-semibold uppercase tracking-wide text-muted-foreground">{tier.entity}</p>
          <p class="mt-3 text-body-sm text-muted-foreground">{tier.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-2xl text-body-sm text-muted-foreground">
      We're inviting early customers in by hand rather than opening self-serve
      billing yet.
    </p>
    <p class="mt-6">
      <Button href="/contact/" arrow>Get in touch</Button>
    </p>
  </Section>
</Layout>
