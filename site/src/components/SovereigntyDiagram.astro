---
/** The line that is not drawn is the point: personal data has no path to
    an external model. Adapted from the equivalent diagram on
    docs.shamwari.ai, redrawn for someone who has never heard the word
    "scope", on the @bundu/ui semantic tokens. */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<figure class:list={['not-prose', className]}>
  <svg viewBox="0 0 640 232" role="img" aria-labelledby="sov-t sov-d">
    <title id="sov-t">Where your data can and cannot go</title>
    <desc id="sov-d">A question about your own life is answered on your own
      device. A general question is allowed to reach Shamwari Cloud and an
      external model. There is no line from your personal data to the
      cloud.</desc>
    <g fill="none" stroke="var(--border)" stroke-width="1.25">
      <path d="M104 60 H176"></path>
      <path d="M104 168 H176"></path>
      <path d="M296 60 H368"></path>
      <path d="M488 60 H556"></path>
    </g>
    <g font-family="var(--font-shamwari-sans)" font-size="12.5">
      <rect x="8" y="38" width="96" height="44" fill="var(--card)" stroke="var(--border)"></rect>
      <text x="56" y="59" text-anchor="middle" fill="var(--foreground)" font-size="11">a general</text>
      <text x="56" y="73" text-anchor="middle" fill="var(--foreground)" font-size="11">question</text>

      <rect x="8" y="146" width="96" height="44" fill="var(--card)" stroke="var(--border)"></rect>
      <text x="56" y="167" text-anchor="middle" fill="var(--foreground)" font-size="11">a question</text>
      <text x="56" y="181" text-anchor="middle" fill="var(--foreground)" font-size="11">about you</text>

      <rect x="176" y="26" width="120" height="176" fill="var(--color-sodalite-container)" stroke="var(--color-sodalite)"></rect>
      <text x="236" y="106" text-anchor="middle" fill="var(--color-sodalite)" font-weight="600">the gate</text>
      <text x="236" y="126" text-anchor="middle" fill="var(--color-sodalite)" font-size="10.5">checked twice</text>

      <rect x="368" y="38" width="120" height="44" fill="var(--card)" stroke="var(--border)"></rect>
      <text x="428" y="65" text-anchor="middle" fill="var(--foreground)">Shamwari Cloud</text>

      <rect x="556" y="38" width="76" height="44" fill="var(--card)" stroke="var(--border)"></rect>
      <text x="594" y="59" text-anchor="middle" fill="var(--foreground)" font-size="11">external</text>
      <text x="594" y="73" text-anchor="middle" fill="var(--foreground)" font-size="11">model</text>

      <rect x="176" y="146" width="312" height="44" fill="var(--card)" stroke="var(--color-sodalite)"></rect>
      <text x="332" y="167" text-anchor="middle" fill="var(--color-sodalite)" font-size="11">Shamwari Mind — on your device, never uploaded</text>
    </g>
  </svg>
  <figcaption class="mt-3 max-w-2xl text-body-sm text-muted-foreground"><slot /></figcaption>
</figure>
<style>
  svg { width: 100%; height: auto; display: block; }
</style>
