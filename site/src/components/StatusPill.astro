---
/** A three-state indicator for what's actually built vs. what's planned.
    Colour alone never carries the meaning — the label always says it too. */
interface Props { state: 'live' | 'building' | 'planned' }
const { state } = Astro.props;
const label = { live: 'Live', building: 'Building', planned: 'Planned' }[state];
const classes = {
  live: 'bg-sodalite-container text-sodalite-on-container',
  building: 'bg-terracotta-container text-terracotta-on-container',
  planned: 'border border-border text-muted-foreground',
}[state];
---
<span class:list={['inline-block rounded-full px-3 py-0.5 text-caption font-semibold uppercase tracking-wider', classes]}>
  {label}
</span>
