---
import '../styles/global.css';
import MineralStrip from '@bundu/ui/MineralStrip.astro';
import Breadcrumb from '@bundu/ui/Breadcrumb.astro';
import { deriveBreadcrumbs } from '@bundu/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const labels = { blueprint: 'Blueprint', project: 'Project', contact: 'Contact' };
const crumbs = deriveBreadcrumbs(Astro.url.pathname, labels, 'Shamwari');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
  />
</head>
<body class="bg-canvas text-foreground">
  <MineralStrip />
  <Header />
  <main>
    {crumbs.length >= 2 && (
      <div class="container-custom pt-6">
        <Breadcrumb items={crumbs} origin={Astro.site?.toString()} />
      </div>
    )}
    <slot />
  </main>
  <Footer />
</body>
</html>
