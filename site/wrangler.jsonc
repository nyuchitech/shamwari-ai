{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shamwari-site",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Astro's static output. No Worker script, no bindings, no secrets.
  "assets": { "directory": "./dist" },

  "routes": [
    { "pattern": "shamwari.ai", "custom_domain": true },
    { "pattern": "www.shamwari.ai", "custom_domain": true }
  ]
}
